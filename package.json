{
  "name": "pliego",
  "version": "1.3.4",
  "description": "Motor de libros pop-up 3D en estilo papercraft para React y React Three Fiber",
  "author": "Alba Alonso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alba-alonso-dev/pliego.git"
  },
  "homepage": "https://alba-alonso-dev.github.io/pliego/",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build",
    "build:playground": "vite build --config playground/vite.config.ts",
    "docs:api": "typedoc",
    "preview": "vite preview --config playground/vite.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "vite build"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.2.0",
    "postprocessing": "^6.36.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.159.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@react-three/test-renderer": "^9.1.1",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "postprocessing": "^6.39.6",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@use-gesture/react": "^10.3.1",
    "gsap": "^3.15.1",
    "zustand": "^5.1.0"
  }
}
